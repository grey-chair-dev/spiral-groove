# Spiral Groove Records — env template (copy to .env.local)
# App only reads keys documented here (plus platform injects like VERCEL_URL).

# ============================================
# DATABASE (required)
# ============================================
SGR_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Legacy alias still accepted by api/db.js:
# SPR_DATABASE_URL=
# DATABASE_URL=

# ============================================
# SQUARE
# ============================================
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
# Web Payments SDK (browser) — also accepted as SQUARE_APPLICATION_ID / SQUARE_WEB_PAYMENTS_APPLICATION_ID
# VITE_SQUARE_APPLICATION_ID=
# VITE_SQUARE_LOCATION_ID=
# VITE_SQUARE_ENVIRONMENT=sandbox

# Square www → /api/square/webhook (HMAC)
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# SQUARE_WEBHOOK_URL=https://www.spiralgrooverecords.com/api/square/webhook

# Shared secret for manual cron/admin POSTs (x-webhook-secret)
WEBHOOK_SECRET=

# Optional catalog-sync tuning
# CATALOG_SYNC_MISMATCH_ALERT_MIN=1
# CATALOG_SYNC_ZERO_STOCK_ALERT_RATIO=0.5

# ============================================
# EMAIL (SMTP only — Make mail webhooks removed)
# ============================================
# See docs/square-webhooks.md
# SGR_SMTP_URL=smtps://resend:<api-key-sgr>@smtp.resend.com:465
# SGR_ALERTS_SMTP_URL=smtps://resend:<api-key-greychair>@smtp.resend.com:465
# SGR_MAIL_FROM="Spiral Groove Records" <noreply@spiralgrooverecords.com>
# SGR_PROJECTS_MAIL_FROM=general@greychair.digital
# SGR_ALERTS_MAIL_FROM=alerts@greychair.digital
# ALERT_EMAIL=alerts@greychair.io
# CONTACT_INQUIRY_TO=adam@spiralgrooverecords.com
# EVENT_INQUIRY_TO=hybridmoments25@gmail.com
# MAIL_DRY_RUN=1
# EMAIL_SUPPRESS_TO=test-inbox@example.com
# ALERT_DB_QUERY_ERRORS=

# ============================================
# SITE / FRONTEND
# ============================================
# VITE_APP_ID=spiral-groove
# VITE_CHECKOUT_MODE=both
# VITE_SHIPPING_FEE=10
# VITE_FREE_SHIPPING_THRESHOLD=0
# SHIPPING_FEE=10
# FREE_SHIPPING_THRESHOLD_CENTS=0
# SITE_URL=https://www.spiralgrooverecords.com
# VITE_GA4_MEASUREMENT_ID=G-xxxxxxx
# VITE_ENABLE_NEWSLETTER=true
# VITE_ENABLE_SOCIAL_LINKS=true
# VITE_ENABLE_PROMO_BAR=true

# Review links in COMPLETED-order email
SGR_REVIEW_URL=https://www.facebook.com/spiralgrooverecords/reviews/?id=100063558614296&sk=reviews
SGR_REVIEW_URL_SECONDARY=https://www.google.com/maps/place/Spiral+Groove+Records/@39.1742742,-84.2984339,17z

# Newsletter unsubscribe HMAC (falls back to JWT_SECRET)
# NEWSLETTER_UNSUBSCRIBE_SECRET=
# JWT_SECRET=

# ============================================
# VERCEL FLAGS
# ============================================
# Pulled via: vercel env pull
# FLAGS=
# FLAGS_SECRET=

# ============================================
# CRONS / LLM
# ============================================
# CRON_SECRET=
# STAFF_PICKS_LLM_API_KEY=sk-ant-...
# STAFF_PICKS_LLM_PROVIDER=anthropic
# STAFF_PICKS_LLM_MODEL=claude-haiku-4-5-20251001
# STAFF_PICKS_LLM_BASE_URL=https://api.anthropic.com

# Instagram → events (api-anything; cron /api/instagram-events-sync)
# INSTAGRAM_USERNAME=spiral_groove_records_
# INSTAGRAM_EVENTS_TZ=America/New_York
# INSTAGRAM_EVENTS_DRY_RUN=1
# API_ANYTHING_HOME=/tmp

# ============================================
# MONTHLY REPORT
# ============================================
MONTHLY_REPORT_RECIPIENTS=brendan@greychair.io
# REPORT_EMAIL=
# MONTHLY_REPORT_FROM=projects@greychair.io
# MONTHLY_REPORT_DATA_SECRET=
# GA4_PROPERTY_ID=516751405
# GA4_SERVICE_ACCOUNT_JSON=
# GA4_SERVICE_ACCOUNT_PATH=docs/grey-chair-digital-service-account.json
